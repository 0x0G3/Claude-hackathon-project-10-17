+    const chip = { gap: chipBase + " background: #facc0a;", thin: chipBase + " border: 1px solid #122640; padding: 3px 6px;", ok: chipBase + " color: #33373d;" };
+    const data = [
+      ["Travel home to family", 1, 1, "gap", "No fit", true],
+      ["ID & documents", 2, 1, "thin", "Thin", false],
+      ["Phone & internet", 1, 1, "thin", "Thin", false],
+      ["Getting around", 1, 1, "thin", "Thin", false],
+      ["Housing help", 3, 3, "ok", "Covered", false],
+      ["Shelter", 2, 7, "ok", "Referral only", false],
+      ["Small loan / business", 1, 2, "ok", "Covered", false],
+      ["Work", 1, 3, "ok", "Covered", false],
+      ["Benefits", 1, 2, "ok", "Covered", false],
+      ["Food", 1, 2, "ok", "Covered", false],
+      ["Legal", 1, 2, "ok", "Covered", false],
+      ["Veterans", 1, 2, "ok", "Covered", false]
+    ];
+    const w = (n) => Math.max(2, Math.round((n / MAX) * 100));
+    const rows = data.map(([label, ask, door, kind, status, misfit]) => ({
+      label, status,
+      ask: String(ask),
+      door: misfit ? door + " · ages 12–21 only" : String(door),
+      askStyle: "display: block; height: 12px; width: " + w(ask) + "%; background: #122640;",
+      doorStyle: "display: block; height: 12px; width: " + w(door) + "%; box-sizing: border-box; " + (misfit ? "border: 1px dashed #122640;" : "background: #facc0a; box-shadow: inset 0 0 0 1px #122640;"),
+      chipStyle: chip[kind]
+    }));
+    const mark = { medium: "width: 11px; height: 11px; flex-shrink: 0; border: 1.5px solid #122640; box-sizing: border-box; box-shadow: inset 5px 0 0 #122640;", low: "width: 11px; height: 11px; flex-shrink: 0; border: 1.5px dashed #122640; box-sizing: border-box;", conflict: "width: 11px; height: 11px; flex-shrink: 0; background: #facc0a; box-shadow: inset 0 0 0 1.5px #122640;" };
+    const recheck = [
+      { name: "Bridges at Kraemer Place", need: "Shelter", kind: "Sources disagree", markStyle: mark.conflict, why: "New operator since July 1, 2026. 211OC still lists the old one." },
+      { name: "Costa Mesa Bridge Shelter", need: "Shelter", kind: "Sources disagree", markStyle: mark.conflict, why: "City says 70 beds, 211OC says 100." },
+      { name: "Free certified birth certificate", need: "ID & documents", kind: "Call to confirm", markStyle: mark.medium, why: "The right is clear. The county office steps are not." },
+      { name: "Reconnection Program (Costa Mesa)", need: "Travel home", kind: "Unsure", markStyle: mark.low, why: "Doesn’t say if travel is paid, how much, or who qualifies." },
+      { name: "Newport Beach reunification travel", need: "Travel home", kind: "Unsure", markStyle: mark.low, why: "An expense line on a city dashboard, not a described program." },
+      { name: "Family Coordinated Entry", need: "Housing help", kind: "Sources disagree", markStyle: mark.conflict, why: "The online request form is closed. Other pages still point to it." },
+      { name: "211 Orange County", need: "General help", kind: "Sources disagree", markStyle: mark.conflict, why: "A second site lists a different number for the same service." },
+      { name: "NAMI OC WarmLine", need: "Mental health", kind: "Sources disagree", markStyle: mark.conflict, why: "Hours appear to have changed between two sources." }
+    ];
+    return { rows, recheck };
+  }
+}
+</script>
