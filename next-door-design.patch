diff --git a/design/prototype/index.html b/design/prototype/index.html
new file mode 100644
index 0000000..a874ee3
--- /dev/null
+++ b/design/prototype/index.html
@@ -0,0 +1,925 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+</head>
+<body>
+<title>Next Door Planner</title>
+<meta name="claude:viewport-fit-sides" content="cover">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Playfair+Display:wght@700;900&display=swap">
+<style>
+/* Layout: IHH brand shell (yellow help bar, navy header with view tabs), then one view at a time.
+   Staff views are dense dashboards on white/sand; client views are phone frames in big plain type.
+   Single light theme by choice: the IHH system is light-only. Square corners, no shadows, no gradients. */
+:root{
+  color-scheme:light;
+  --yellow:#facc0a; --indigo:#1a2187; --navy:#122640; --sand:#ede5de; --white:#ffffff; --charcoal:#33373d;
+  --bg:var(--white); --bg-soft:var(--sand); --text:var(--navy); --text-muted:var(--charcoal);
+  --font-display:"IvyPresto Display","ivypresto-display","Playfair Display",Georgia,serif;
+  --font-quote:"Playfair Display",Georgia,serif;
+  --font-sans:Archivo,system-ui,-apple-system,"Segoe UI",sans-serif;
+  --gutter:20px; --content-max:1200px; --section-y:48px;
+}
+*{box-sizing:border-box}
+body{background:var(--bg);color:var(--text);font-family:var(--font-sans);font-size:15px;line-height:1.6}
+body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--navy)}
+.wrap{max-width:var(--content-max);margin:0 auto;padding-left:max(var(--gutter),env(safe-area-inset-left,0px));padding-right:max(var(--gutter),env(safe-area-inset-right,0px))}
+a{color:var(--navy)}
+:focus-visible{outline:2px solid var(--navy);outline-offset:2px}
+.dark :focus-visible,.dark:focus-visible{outline-color:var(--yellow)}
+h1,h2,h3{text-wrap:balance}
+.eyebrow{font:500 12.5px/1.25 var(--font-sans);letter-spacing:1px;text-transform:uppercase;margin:0;color:var(--text-muted)}
+.h-display{font:700 clamp(30px,4vw,44px)/1.15 var(--font-display);margin:0}
+.h2{font:700 clamp(26px,3vw,34px)/1.2 var(--font-display);margin:0}
+.h3{font:700 22px/1.25 var(--font-display);margin:0}
+.sub{color:var(--text-muted);margin:0;max-width:68ch}
+.num{font-variant-numeric:lining-nums tabular-nums}
+
+/* ---- utility bar + header ---- */
+.utility{background:var(--yellow);color:var(--navy);font:500 13px/1.4 var(--font-sans)}
+.utility .wrap{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 18px;padding-block:8px;text-align:center}
+.utility b{font-weight:700}
+.utility .proto{font-weight:600;text-transform:uppercase;letter-spacing:1px;font-size:11.5px}
+header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--navy);color:var(--white)}
+header.top .wrap{display:flex;flex-wrap:wrap;align-items:stretch;gap:0 28px;min-height:64px}
+.brand{display:flex;align-items:center;gap:14px;padding-block:12px}
+.brand img{height:22px;width:auto;display:block}
+.brand span{font:600 12px/1 var(--font-sans);letter-spacing:1px;text-transform:uppercase;border-left:1px solid var(--white);padding-left:14px;white-space:nowrap}
+.tabs{flex:1;display:flex;align-items:stretch;gap:22px;overflow-x:auto;min-width:0;scrollbar-width:none}
+.tabs::-webkit-scrollbar{display:none}
+.tabgroup{display:flex;align-items:stretch;gap:18px}
+.tabgroup + .tabgroup{border-left:1px solid rgba(255,255,255,.35);padding-left:22px}
+.tabgroup small{align-self:center;font:500 10.5px/1 var(--font-sans);letter-spacing:1px;text-transform:uppercase;color:var(--yellow)}
+.tabs button{font:600 12px/1 var(--font-sans);letter-spacing:.5px;text-transform:uppercase;color:var(--white);background:none;border:0;border-bottom:2px solid transparent;padding:0 0 2px;cursor:pointer;white-space:nowrap}
+.tabs button[aria-selected="true"],.tabs button:hover{border-bottom-color:var(--yellow)}
+.tabs button:focus-visible{outline:2px solid var(--yellow);outline-offset:4px}
+.gethelp{display:flex;align-items:center;font:500 14px/1 var(--font-sans);text-transform:uppercase;background:var(--yellow);color:var(--navy);padding-inline:22px;border:0;cursor:pointer;margin-right:calc(-1 * max(var(--gutter),env(safe-area-inset-right,0px)))}
+@media (max-width:900px){
+  header.top .wrap{gap:0}
+  .brand{flex:1}
+  .gethelp{order:2}
+  .tabs{order:3;flex-basis:100%;padding-block:4px 12px}
+  .tabs button{padding-block:8px}
+}
+
+/* ---- intro ---- */
+.intro{background:var(--sand)}
+.intro .wrap{padding-block:36px 32px;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:24px 48px;align-items:start}
+.intro p.lead{font-size:16px;line-height:1.8;margin:14px 0 0;max-width:60ch}
+.index{margin:0;padding:0;list-style:none;display:grid;border-top:2px solid var(--navy)}
+.index li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;padding:9px 0;border-bottom:1px solid var(--navy)}
+.index button{font:700 15px/1.3 var(--font-sans);color:var(--navy);background:none;border:0;padding:0;text-align:left;cursor:pointer;text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
+.index span{font-size:13px;color:var(--text-muted)}
+.index em{font:600 11px/1.6 var(--font-sans);font-style:normal;letter-spacing:1px;text-transform:uppercase;color:var(--navy);grid-row:1/3;grid-column:2;align-self:center}
+.tryrow{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
+.try{font:600 13px/1.2 var(--font-sans);padding:10px 14px;border:1px solid var(--navy);background:var(--white);color:var(--navy);cursor:pointer;text-align:left}
+.try:hover{background:var(--navy);color:var(--white)}
+.try small{display:block;font-weight:500;font-size:11.5px;letter-spacing:.5px;text-transform:uppercase;opacity:.8;margin-top:2px}
+@media (max-width:860px){.intro .wrap{grid-template-columns:1fr}}
+
+/* ---- view frame ---- */
+main .view{padding-block:32px 56px}
+.viewhead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:12px 24px;margin-bottom:22px}
+.viewhead > div{display:grid;gap:6px;min-width:0}
+.who{font:600 11px/1 var(--font-sans);letter-spacing:1px;text-transform:uppercase;background:var(--navy);color:var(--white);padding:6px 9px;display:inline-block;justify-self:start}
+.who.client{background:var(--yellow);color:var(--navy)}
+.who.lead{background:var(--indigo)}
+
+/* ---- buttons, chips, confidence ---- */
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font:500 14px/1 var(--font-sans);text-transform:uppercase;padding:12px 28px;border:1px solid var(--navy);background:var(--white);color:var(--navy);cursor:pointer;white-space:nowrap}
+.btn:hover{background:var(--navy);color:var(--white)}
+.btn.primary{background:var(--yellow);border-color:var(--yellow);color:var(--navy)}
+.btn.primary:hover{background:var(--navy);border-color:var(--navy);color:var(--yellow)}
+.btn.thick{border-width:2px}
+.btn.big{font-size:16px;padding:18px 28px;width:100%}
+.btns{display:flex;flex-wrap:wrap;gap:10px}
+.chips{display:flex;flex-wrap:wrap;gap:5px}
+.chip{display:inline-flex;align-items:center;gap:6px;font:600 10.5px/1 var(--font-sans);letter-spacing:.8px;text-transform:uppercase;padding:5px 7px;border:1px solid var(--navy);background:var(--white);color:var(--navy);white-space:nowrap}
+.chip.navy{background:var(--navy);color:var(--white)}
+.chip.yellow{background:var(--yellow);border-color:var(--yellow)}
+.chip.indigo{background:var(--indigo);border-color:var(--indigo);color:var(--white)}
+.chip.sand{background:var(--sand);border-color:var(--sand)}
+.chip.dashed{border-style:dashed}
+.conf{display:inline-flex;align-items:center;gap:7px;font:600 12px/1.3 var(--font-sans);color:var(--navy)}
+.conf i{width:11px;height:11px;border:1.5px solid var(--navy);flex:none;position:relative;background:var(--white)}
+.conf.high i{background:var(--navy)}
+.conf.medium i::after{content:"";position:absolute;inset:0 50% 0 0;background:var(--navy)}
+.conf.low i{border-style:dashed}
+.unk{font-style:italic;color:var(--text-muted);border-bottom:1px dashed var(--navy)}
+.toast{font-size:13px;font-weight:600;min-height:1.4em}
+
+/* ---- stat band (dark) ---- */
+.stats{background:var(--navy);color:var(--white);display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));margin-bottom:28px}
+.stat{padding:20px 24px;display:grid;gap:4px;align-content:start;border-right:1px solid rgba(255,255,255,.25)}
+.stat:last-child{border-right:0}
+.stat b{font:700 46px/1.05 var(--font-display);color:var(--yellow);font-variant-numeric:lining-nums tabular-nums}
+.stat span{font:600 13px/1.3 var(--font-sans);text-transform:uppercase;letter-spacing:.8px}
+.stat small{font-size:13px;line-height:1.45;opacity:.9}
+
+/* ---- today: load + board ---- */
+.load{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin:10px 0 28px}
+.cm{background:var(--sand);padding:12px 14px;display:grid;gap:7px}
+.cm .row{display:flex;justify-content:space-between;gap:8px;font-size:14px}
+.meter{height:8px;background:var(--white)}
+.meter i{display:block;height:100%;background:var(--navy)}
+.meter.hot i{background:var(--yellow);border:1px solid var(--navy)}
+.boardscroll{overflow-x:auto;padding-bottom:6px}
+.board{display:grid;grid-template-columns:repeat(5,minmax(210px,1fr));gap:10px;min-width:1080px}
+.col{background:var(--sand);padding:10px;display:flex;flex-direction:column;gap:8px}
+.col h3{display:flex;justify-content:space-between;margin:2px 2px 4px;font:600 11.5px/1.2 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.card{background:var(--white);border:1px solid var(--white);padding:11px 12px;display:grid;gap:7px;text-align:left;font:inherit;color:inherit;cursor:pointer;width:100%}
+.card:hover{border-color:var(--navy)}
+.card .top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
+.card .name{font:700 17px/1.2 var(--font-display)}
+.days{font:600 12px/1 var(--font-sans);white-space:nowrap}
+.days.soon{background:var(--yellow);padding:4px 6px}
+.card .title{font-size:13px;color:var(--text-muted);line-height:1.4}
+.owner{font-size:12px;color:var(--text-muted)}
+
+/* ---- review ---- */
+.casebar{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;margin-bottom:18px}
+select{font:500 14px var(--font-sans);padding:9px 10px;border:1px solid var(--navy);background:var(--white);color:var(--navy);max-width:100%;border-radius:0}
+.panes{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr) minmax(0,1.15fr);gap:18px;align-items:start}
+@media (max-width:1080px){.panes{grid-template-columns:1fr}}
+.pane{min-width:0;display:grid;gap:14px;align-content:start}
+.voice{background:var(--sand);padding:22px 20px;display:grid;gap:12px}
+.voice .q{font:900 22px/1.4 var(--font-quote);margin:0}
+.voice .c{margin:0;font-size:14px;color:var(--text-muted)}
+ul.plain{margin:0;padding-left:18px;display:grid;gap:3px;font-size:14px}
+.checks{display:grid;border-top:2px solid var(--navy)}
+.checks div{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 10px;padding:9px 0;border-bottom:1px solid var(--navy);font-size:14px;line-height:1.45}
+.checks b{font:600 11px/1.6 var(--font-sans);letter-spacing:1px;text-transform:uppercase;padding:2px 6px;align-self:start}
+.checks .ok b{border:1px solid var(--navy)}
+.checks .stop b{background:var(--navy);color:var(--white)}
+.checks .warn b{background:var(--yellow)}
+.need{display:grid;gap:8px}
+.need h4{margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font:700 18px/1.3 var(--font-display)}
+.res{border:1px solid var(--navy);padding:12px 14px;display:grid;gap:8px;background:var(--white)}
+.res.picked{outline:3px solid var(--yellow);outline-offset:-1px}
+.res .rt{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 10px;align-items:baseline}
+.res .rn{font-weight:700}
+dl.kv{display:grid;grid-template-columns:auto minmax(0,1fr);gap:3px 12px;margin:0;font-size:13px;line-height:1.45}
+dl.kv dt{color:var(--text-muted)}
+dl.kv dd{margin:0;min-width:0;overflow-wrap:anywhere}
+.src{font-size:12px;color:var(--text-muted);display:flex;flex-wrap:wrap;gap:4px 12px;align-items:center}
+.pickrow{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600}
+.pickrow input{accent-color:var(--navy);width:16px;height:16px}
+.empty{padding:14px;border:1px dashed var(--navy);font-size:14px}
+.legend{display:flex;flex-wrap:wrap;gap:6px 16px;padding:10px 12px;background:var(--sand)}
+textarea{width:100%;min-height:130px;font:14px/1.5 var(--font-sans);padding:10px;border:1px solid var(--navy);background:var(--white);color:var(--navy);resize:vertical;border-radius:0}
+details.more summary{cursor:pointer;font:600 12px/1.4 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.approve{background:var(--sand);padding:16px;display:grid;gap:12px}
+
+/* ---- plan card (shared by client, review, printout) ---- */
+.plancard{background:var(--white);border:2px solid var(--navy);display:grid;color:var(--navy)}
+.pc-head{background:var(--yellow);padding:18px 18px 16px;display:grid;gap:6px}
+.pc-head .eyebrow{color:var(--navy)}
+.pc-head h3{font:700 26px/1.15 var(--font-display);margin:0}
+.pc-body{padding:16px 18px 18px;display:grid;gap:16px}
+.pc-step{display:grid;grid-template-columns:30px minmax(0,1fr);gap:4px 12px}
+.pc-step .n{font:700 24px/1 var(--font-display)}
+.pc-step h4{margin:0;font:600 12px/1.5 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.pc-step p{margin:0;font-size:17px;line-height:1.5}
+.pc-step ul{margin:2px 0 0;padding-left:18px;font-size:16px;line-height:1.5}
+.phone-big{font:700 26px/1.2 var(--font-sans);letter-spacing:.5px;user-select:all;font-variant-numeric:tabular-nums}
+.say{font-size:16px;line-height:1.55;background:var(--sand);padding:10px 12px;margin:0}
+.pc-foot{border-top:1px solid var(--navy);padding:12px 18px;display:grid;gap:6px;font-size:13px}
+.pc-after{border-top:1px solid var(--navy);padding:14px 18px;display:grid;gap:10px}
+.pc-after h5{margin:0;font:600 12px/1.4 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.pc-after .door{display:grid;gap:2px;font-size:15px}
+.pc-en{background:var(--sand);padding:12px 18px;font-size:13px;line-height:1.5;display:grid;gap:4px}
+.pc-en b{font:600 11px/1.4 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.plancard details summary{cursor:pointer;font:600 12px/1.4 var(--font-sans);letter-spacing:1px;text-transform:uppercase;padding:12px 18px;border-top:1px solid var(--navy)}
+.plancard details .alt{padding:0 18px 14px;display:grid;gap:10px;font-size:15px}
+
+/* ---- client: phones ---- */
+.clientgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,380px));gap:28px;justify-content:start;align-items:start}
+.phone{width:100%;max-width:380px;border:2px solid var(--navy);background:var(--white);display:grid;align-content:start}
+.phone .bar{background:var(--navy);color:var(--white);display:flex;justify-content:space-between;align-items:center;padding:10px 14px}
+.phone .bar img{height:16px;width:auto;display:block}
+.phone .bar span{font:600 11px/1 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.phone .help{background:var(--yellow);font:500 13px/1.4 var(--font-sans);padding:7px 14px}
+.phone .scr{padding:18px 16px 22px;display:grid;gap:16px;min-height:560px;align-content:start}
+.phone-label{font:600 11px/1 var(--font-sans);letter-spacing:1px;text-transform:uppercase;margin:0 0 8px;color:var(--text-muted)}
+.bigq{font:700 28px/1.2 var(--font-display);margin:0}
+.client-ta{font-size:18px;line-height:1.5;min-height:120px}
+.taps{display:flex;flex-wrap:wrap;gap:8px}
+.tap{font:500 15px/1.2 var(--font-sans);padding:11px 13px;border:1px solid var(--navy);background:var(--white);color:var(--navy);cursor:pointer;min-height:44px}
+.tap[aria-pressed="true"]{background:var(--navy);color:var(--white)}
+.lang{display:flex;gap:0;border:1px solid var(--navy)}
+.lang button{flex:1;font:600 14px/1 var(--font-sans);padding:12px 6px;background:var(--white);color:var(--navy);border:0;border-right:1px solid var(--navy);cursor:pointer;min-height:44px}
+.lang button:last-child{border-right:0}
+.lang button[aria-pressed="true"]{background:var(--navy);color:var(--white)}
+.lang button:disabled{color:var(--text-muted);cursor:not-allowed}
+.fieldlabel{font:600 12px/1.25 var(--font-sans);letter-spacing:1px;text-transform:uppercase;margin:0}
+.states{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;align-items:center}
+.dark{background:var(--navy);color:var(--white)}
+.safe{display:grid;gap:16px;padding:24px 18px}
+.safe img{width:56px;height:auto}
+.safe h3{font:700 30px/1.2 var(--font-display);margin:0}
+.safe h3 em{font-style:normal;color:var(--yellow)}
+.safe p{margin:0;font-size:18px;line-height:1.5}
+.safe .call{border:2px solid var(--white);padding:14px;display:grid;gap:2px}
+.safe .call b{font:700 34px/1.1 var(--font-sans);color:var(--yellow)}
+.btn.onDark{background:transparent;color:var(--white);border:2px solid var(--white)}
+.btn.onDark:hover{background:var(--white);color:var(--navy)}
+.staffnote{font-size:13px;line-height:1.5;border-top:1px solid rgba(255,255,255,.4);padding-top:12px;opacity:.95}
+.calm{background:var(--sand);padding:22px 18px;display:grid;gap:14px}
+.calm h3{font:700 28px/1.2 var(--font-display);margin:0}
+.calm p{margin:0;font-size:18px;line-height:1.5}
+.gapbox{display:grid;gap:14px}
+.gapbox .lede{background:var(--sand);padding:18px;display:grid;gap:8px}
+.gapbox .lede h3{font:700 26px/1.2 var(--font-display);margin:0}
+.gapbox p{margin:0;font-size:17px;line-height:1.5}
+.nextstep{border:2px solid var(--navy);padding:14px 16px;display:grid;gap:4px}
+.nextstep b{font:600 12px/1.4 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+.nextstep span{font:700 22px/1.25 var(--font-display)}
+
+/* ---- gaps dashboard ---- */
+.twocol{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:28px;align-items:start}
+@media (max-width:980px){.twocol{grid-template-columns:1fr}}
+.panel{display:grid;gap:12px;min-width:0}
+.panel > header{display:grid;gap:4px;border-bottom:2px solid var(--navy);padding-bottom:8px}
+.bars{display:grid;gap:0}
+.brow{display:grid;grid-template-columns:minmax(110px,170px) minmax(0,1fr) auto;gap:4px 14px;align-items:center;padding:9px 0;border-bottom:1px solid var(--sand)}
+.brow .lbl{font-weight:600;font-size:14px;line-height:1.3}
+.brow .tracks{display:grid;gap:4px}
+.track{display:flex;align-items:center;gap:8px;font-size:12px;font-variant-numeric:tabular-nums}
+.track i{display:block;height:12px;min-width:2px}
+.track.ask i{background:var(--navy)}
+.track.door i{background:var(--yellow);outline:1px solid var(--navy);outline-offset:-1px}
+.keyrow{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:13px}
+.keyrow span{display:inline-flex;align-items:center;gap:7px}
+.keyrow i{width:14px;height:10px;display:inline-block}
+.tablewrap{overflow-x:auto}
+table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
+th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--navy);font-size:13.5px;vertical-align:top}
+th{font:600 11px/1.3 var(--font-sans);letter-spacing:1px;text-transform:uppercase;border-bottom-width:2px}
+td.n{text-align:right}
+.pull{background:var(--sand);padding:36px 24px;margin-top:32px;text-align:center;display:grid;gap:14px;justify-items:center}
+.pull img{width:40px;height:auto}
+.pull p{font:900 clamp(22px,2.6vw,30px)/1.4 var(--font-quote);margin:0;max-width:36ch;text-wrap:balance}
+.pull small{font:500 12px/1.2 var(--font-sans);letter-spacing:1px;text-transform:uppercase}
+
+/* ---- printout ---- */
+.paperdesk{background:var(--sand);padding:28px 16px}
+.paper{background:var(--white);max-width:816px;margin:0 auto;padding:clamp(20px,5vw,56px);display:grid;gap:22px;color:var(--navy)}
+.paper .ph{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;border-bottom:2px solid var(--navy);padding-bottom:14px}
+.paper .ph img{height:34px;width:auto}
+.paper .ph div{text-align:right;font-size:13px;line-height:1.5}
+.paper h2{font:700 34px/1.15 var(--font-display);margin:0}
+.paper .plancard{border-width:2px}
+.paper .pc-step p{font-size:19px}
+.paper .pfoot{font-size:12px;line-height:1.55;color:var(--text-muted);border-top:1px solid var(--navy);padding-top:12px;display:grid;gap:6px}
+@media print{.utility,header.top,.intro,footer,.viewhead,.noprint{display:none!important}.paperdesk{background:none;padding:0}}
+
+/* ---- how it works (kept from the draft guideline) ---- */
+.flow{border:1px solid var(--navy);padding:16px;margin:0 0 22px;overflow-x:auto}
+.flow svg{display:block;width:100%;min-width:860px;height:auto;color:var(--navy);font-family:var(--font-sans)}
+.flow figcaption{color:var(--text-muted);font-size:13px;margin-top:8px}
+.flow .box{fill:var(--white);stroke:var(--navy);stroke-width:1.5}
+.flow .claude{fill:var(--yellow);stroke:var(--navy);stroke-width:2}
+.flow .store{fill:var(--sand);stroke:var(--navy);stroke-width:1}
+.flow .stop{fill:var(--white);stroke:var(--navy);stroke-width:2.5;stroke-dasharray:6 4}
+.flow .t{font-size:13px;font-weight:700;fill:var(--navy)}
+.flow .s{font-size:11px;fill:var(--charcoal)}
+.flow .own{font:600 10.5px var(--font-sans);fill:var(--indigo);letter-spacing:.5px}
+.flow .lbl{font-size:10.5px;fill:var(--charcoal)}
+.flow .ln{stroke:var(--navy);stroke-width:1.4;fill:none}
+.flow .dash{stroke-dasharray:5 4}
+.flow .red{stroke:var(--navy);stroke-width:2.4}
+.handoff{overflow-x:auto;margin-bottom:32px}
+.handoff table{min-width:640px}
+.road{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:14px 0 18px}
+.phase{border:1px solid var(--navy);padding:14px;display:grid;gap:8px;align-content:start;min-width:0}
+.phase.now{background:var(--yellow);border-color:var(--yellow)}
+.phase .when{font:600 11px/1.3 var(--font-sans);letter-spacing:1px;text-transform:uppercase;color:var(--indigo)}
+.phase.now .when{color:var(--navy)}
+.phase h3{margin:0;font:700 19px/1.25 var(--font-display)}
+.phase ul{margin:0;padding-left:18px;display:grid;gap:4px;font-size:13.5px}
+.gate{font-size:13px;background:var(--sand);padding:8px 10px}
+.phase.now .gate{background:var(--white)}
+.gate b{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase}
+.ask{background:var(--navy);color:var(--white);padding:18px 20px;display:grid;gap:8px}
