+  </div>
+  <div style="padding: 32px 48px 36px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 30px; flex-grow: 1;">
+
+    <div style="grid-column: span 6; display: flex; flex-direction: column; gap: 12px;">
