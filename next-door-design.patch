+{
+  "name": "Illumination Health + Home",
+  "version": 1,
+  "meta": { "source": "illuminationhealthhome.org Elementor global kit + IHH design brief, captured 2026-10-17" },
+  "color": {
+    "themes": [{ "id": "light", "name": "Light" }],
+    "tokens": [
+      { "name": "yellow", "value": "#facc0a", "usage": "Sunflower Yellow, the signature color. Fills only: primary CTAs, the utility bar, service card (Housing), story-card footers, newsletter band. As text, only on navy, indigo or a scrimmed photo (headline keywords, stat numbers). Never text on white (1.53:1). Logo files use #FACC10; treat as the same color." },
+      { "name": "indigo", "value": "#1a2187", "usage": "Illumination Indigo, the second block color: Healthcare service card, ticker band, outline buttons on indigo. White text on it 13.0:1; yellow on it 8.5:1." },
+      { "name": "navy", "value": "#122640", "usage": "Midnight Navy: default text and headings on white, sand and yellow; the header bar, GET HELP button, dark sections. 15.3:1 on white, 12.3:1 on sand, 9.95:1 on yellow." },
+      { "name": "sand", "value": "#ede5de", "usage": "Warm Sand: soft section backgrounds (testimonials, rest areas between white sections). Navy and charcoal text read on it." },
+      { "name": "white", "value": "#ffffff", "usage": "Page background; text on navy, indigo and scrimmed photos." },
+      { "name": "charcoal", "value": "#33373d", "usage": "Secondary body text on white (12.0:1) and sand (9.6:1)." },
+      { "name": "black", "value": "#000000", "usage": "Base of the photo scrim only. Not a text color; text is navy." },
+      { "name": "logo-indigo", "value": "#2d307f", "usage": "Wordmark color in IHH-Logo-Variant-2 on light grounds. Logo use only; never a UI color." },
+      { "name": "scrim", "value": "rgba(0, 0, 0, 0.5)", "usage": "50% black overlay on every photo that carries white text (hero, impact stats)." },
+      { "name": "navy-glass", "value": "rgba(18, 38, 64, 0.533)", "usage": "Fill of the ghost button on photos (MORE ABOUT US). Always over a scrimmed photo." },
+      { "name": "bg", "value": "{white}", "usage": "Semantic: page background." },
+      { "name": "bg-soft", "value": "{sand}", "usage": "Semantic: alternate section background." },
+      { "name": "text", "value": "{navy}", "usage": "Semantic: body copy and headings on bg, bg-soft and accent." },
+      { "name": "text-muted", "value": "{charcoal}", "usage": "Semantic: secondary copy on bg and bg-soft." },
+      { "name": "accent", "value": "{yellow}", "usage": "Semantic: primary action fill and signature blocks." },
+      { "name": "on-accent", "value": "{navy}", "usage": "Semantic: text and icons on accent. Never white on yellow." },
+      { "name": "primary", "value": "{indigo}", "usage": "Semantic: secondary block color." },
+      { "name": "on-primary", "value": "{white}", "usage": "Semantic: text and borders on primary." },
+      { "name": "dark", "value": "{navy}", "usage": "Semantic: dark bars and sections (header, footer-less dark bands)." },
+      { "name": "on-dark", "value": "{white}", "usage": "Semantic: text on dark and on scrimmed photos." },
+      { "name": "highlight-on-dark", "value": "{yellow}", "usage": "Semantic: the 1–2 highlighted headline words and stat numbers, on dark, primary or a scrimmed photo only." },
+      { "name": "focus-ring", "value": "{navy}", "usage": "Intentional addition: 2px solid keyboard focus outline, offset 2px, on white, sand and yellow grounds (≥9.9:1)." },
+      { "name": "focus-ring-on-dark", "value": "{yellow}", "usage": "Intentional addition: focus outline on navy, indigo and photo grounds (≥8.5:1)." }
+    ]
+  },
+  "type": {
+    "fonts": [
+      { "family": "Archivo", "file": "fonts/Archivo-400.woff2", "weight": "400", "style": "normal" },
+      { "family": "Archivo", "file": "fonts/Archivo-500.woff2", "weight": "500", "style": "normal" },
+      { "family": "Archivo", "file": "fonts/Archivo-600.woff2", "weight": "600", "style": "normal" },
+      { "family": "Archivo", "file": "fonts/Archivo-700.woff2", "weight": "700", "style": "normal" },
+      { "family": "Playfair Display", "file": "fonts/PlayfairDisplay-700.woff2", "weight": "700", "style": "normal" },
+      { "family": "Playfair Display", "file": "fonts/PlayfairDisplay-900.woff2", "weight": "900", "style": "normal" }
+    ],
+    "families": {
+      "display": "\"IvyPresto Display\", \"ivypresto-display\", \"Playfair Display\", Georgia, serif",
+      "quote": "\"Playfair Display\", Georgia, serif",
+      "sans": "Archivo, system-ui, -apple-system, \"Segoe UI\", sans-serif"
+    },
+    "groups": [
+      {
+        "name": "Display",
+        "family": "display",
+        "note": "IvyPresto Display 700 on the live site (Adobe Fonts, licensed). Playfair Display 700 is the shipped stand-in. Sentence case. Emotion only: headlines, quotes, numbers.",
+        "styles": [
+          { "name": "display", "fontSize": "60px", "lineHeight": 1.1, "fontWeight": 700, "sample": "We build the bridge between survival and stability.", "usage": "H1 and hero headline (40–60px responsive). One per page." },
+          { "name": "h2", "fontSize": "44px", "lineHeight": 1.25, "fontWeight": 700, "sample": "From crisis to stability, one step at a time.", "usage": "Section headings. 34px on the home page." },
+          { "name": "h3", "fontSize": "32px", "lineHeight": 1.18, "fontWeight": 700, "sample": "Housing Services", "usage": "Service-card titles and sub-sections." },
+          { "name": "stat", "fontSize": "50px", "lineHeight": 1.25, "fontWeight": 700, "sample": "450,886", "usage": "Impact numbers, in highlight-on-dark over a dark or scrimmed ground." }
+        ]
+      },
+      {
+        "name": "Quote",
+        "family": "quote",
+        "styles": [
+          { "name": "quote", "fontSize": "40px", "lineHeight": 1.4, "fontWeight": 900, "sample": "“I didn’t think I would come out of this on track and with my own apartment.”", "usage": "Testimonial pull quotes, navy on sand. Curly quotes always." },
+          { "name": "quote-sm", "fontSize": "28px", "lineHeight": 1.4, "fontWeight": 900, "sample": "“They reminded me who I was.”", "usage": "Pull quotes on mobile or in narrow columns." }
+        ]
+      },
+      {
+        "name": "Text",
+        "family": "sans",
+        "note": "Archivo for everything functional. Uppercase styles (eyebrow, button, nav, label-lg) set text-transform: uppercase in the component.",
+        "styles": [
+          { "name": "body", "fontSize": "16px", "lineHeight": 1.8, "fontWeight": 400, "sample": "We meet people where they are and walk with them toward new possibilities.", "usage": "Running text. 14px on the home page." },
+          { "name": "body-strong", "fontSize": "16px", "lineHeight": 1.8, "fontWeight": 600, "sample": "Stability starts with a roof—and grows from there.", "usage": "Lead sentence that opens a card or paragraph." },
+          { "name": "card-title", "fontSize": "20px", "lineHeight": 1.25, "fontWeight": 700, "sample": "Recuperative care", "usage": "Small card and list-item titles." },
+          { "name": "label-lg", "fontSize": "18px", "lineHeight": 1.1, "fontWeight": 600, "sample": "LAST YEAR ALONE:", "usage": "Big uppercase labels above stats." },
+          { "name": "eyebrow", "fontSize": "13.5px", "lineHeight": 1.25, "fontWeight": 500, "letterSpacing": "1px", "sample": "SUCCESS STORIES", "usage": "Uppercase overline above a heading, 12–13.5px." },
+          { "name": "button", "fontSize": "14px", "lineHeight": 1, "fontWeight": 500, "sample": "GET HELP", "usage": "Uppercase button labels; verbs." },
+          { "name": "nav", "fontSize": "12px", "lineHeight": 1, "fontWeight": 600, "sample": "SERVICES", "usage": "Uppercase header navigation." }
+        ]
+      }
+    ]
+  },
+  "spacing": {
+    "tokens": [
+      { "name": "gutter", "value": "20px", "usage": "Side gutter of the content column at every width." },
+      { "name": "card-pad-y", "value": "40px", "usage": "Vertical padding inside service and content cards." },
+      { "name": "card-pad-x", "value": "30px", "usage": "Horizontal padding inside service and content cards." },
+      { "name": "section-y", "value": "70px", "usage": "Vertical padding of a standard section." },
+      { "name": "hero-top", "value": "190px", "usage": "Top padding of the hero on desktop (under the sticky header)." },
+      { "name": "btn-pad-y", "value": "12px", "usage": "Vertical padding of standard buttons." },
+      { "name": "btn-pad-x", "value": "36px", "usage": "Horizontal padding of standard buttons." },
+      { "name": "btn-sm-pad-y", "value": "8px", "usage": "Vertical padding of small and ghost buttons." },
+      { "name": "btn-sm-pad-x", "value": "32px", "usage": "Horizontal padding of small and ghost buttons." }
+    ]
+  },
+  "radius": {
+    "note": "Square everywhere. This is a defining trait.",
+    "tokens": [
+      { "name": "radius", "value": "0", "usage": "Every button, card, image and input. The only exception is the round carousel arrow buttons." }
+    ]
+  },
+  "shadow": {
+    "note": "No shadows. Depth comes from color blocks and photo scrims.",
+    "tokens": [
+      { "name": "shadow", "value": "none", "usage": "Everything." }
+    ]
+  },
+  "border": {
+    "note": "Solid, navy or white, never grey.",
+    "tokens": [
+      { "name": "border-thin", "value": "1px", "usage": "Dark button border, underline inputs." },
+      { "name": "border-thick", "value": "2px", "usage": "Outline buttons (LEARN MORE, JOIN)." }
