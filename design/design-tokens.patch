+
+  .btn-primary:not(:disabled):hover {
+    background: var(--ihh-navy);
+    color: var(--ihh-yellow);
+  }
+
+  .on-dark .btn-primary,
+  .btn-primary.btn-on-dark {
+    border-color: var(--accent);
+  }
+
+  .on-dark .btn-primary:not(:disabled):hover,
+  .btn-primary.btn-on-dark:not(:disabled):hover {
+    background: var(--ihh-white);
+    color: var(--ihh-navy);
+    border-color: var(--ihh-white);
+  }
+
+  .btn-secondary {
+    background: var(--ihh-white);
+    color: var(--ihh-navy);
+  }
+
+  .btn-secondary:not(:disabled):hover {
+    background: var(--ihh-navy);
+    color: var(--ihh-white);
+  }
+
+  .on-dark .btn-secondary {
+    background: transparent;
+    color: var(--ihh-white);
+    border-color: var(--ihh-white);
+  }
+
+  .on-dark .btn-secondary:not(:disabled):hover {
+    background: var(--ihh-white);
+    color: var(--ihh-navy);
+  }
+
+  .btn-sm {
+    min-height: var(--tap-sm);
+    padding: 0 18px;
+    font-size: 14px;
+  }
+
+  .btn-lg {
+    min-height: var(--tap-lg);
+    padding: 0 32px;
+    font-size: 17px;
+  }
+
+  .btn-xl {
+    min-height: var(--tap-xl);
+    padding: 0 24px;
+    font-size: 20px;
+    text-transform: none;
+    letter-spacing: 0;
+  }
+
+  .btn-block {
+    display: flex;
+    width: 100%;
+  }
+
+  .btn-link {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    min-height: var(--tap-sm);
+    background: none;
+    border: 0;
+    padding: 0;
+    color: inherit;
+    font: 600 15px/1.3 var(--font-sans);
+    text-decoration: underline;
+    text-underline-offset: 3px;
+    cursor: pointer;
+  }
+
+  /* ---------- Blocks ---------- */
+  .panel {
+    background: var(--ihh-white);
+    border: var(--border-thick) solid var(--ihh-navy);
+  }
+
+  .panel-soft {
+    background: var(--ihh-sand);
+  }
+
+  .rule {
+    border-bottom: var(--border-thick) solid var(--ihh-navy);
+    padding-bottom: 8px;
+  }
+
+  .tag {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    padding: 2px 8px;
+    border: var(--border-thin) solid var(--ihh-navy);
+    font: 600 12px/1.4 var(--font-sans);
+    color: var(--ihh-navy);
+    background: var(--ihh-white);
+  }
+
+  .tag-accent {
+    background: var(--ihh-yellow);
+  }
+
+  .tag-dark {
+    background: var(--ihh-navy);
+    color: var(--ihh-white);
+  }
+
+  .tag-medicine {
+    background: var(--ihh-indigo);
+    border-color: var(--ihh-indigo);
+    color: var(--ihh-white);
+  }
+
+  /* ---------- Confidence marks ----------
+     Shape, not color: survives a black-and-white printout and color blindness.
+     high = filled navy square · medium = half-filled ("call to confirm") · low = dashed outline (never the main door) */
+  .mark {
+    display: inline-block;
+    flex-shrink: 0;
+    width: 14px;
+    height: 14px;
+    box-sizing: border-box;
+    border: var(--border-thick) solid var(--ihh-navy);
+  }
+
+  .mark-high {
+    background: var(--ihh-navy);
+  }
+
+  /* Hard 50% stop: a half fill, not a visual gradient */
+  .mark-medium {
+    background: linear-gradient(to right, var(--ihh-navy) 50%, transparent 50%);
+  }
+
+  .mark-low {
+    border-style: dashed;
+    background: transparent;
+  }
+
+  .on-dark .mark {
+    border-color: var(--ihh-white);
+  }
+
+  .on-dark .mark-high {
+    background: var(--ihh-white);
+  }
+
+  .on-dark .mark-medium {
+    background: linear-gradient(to right, var(--ihh-white) 50%, transparent 50%);
+  }
+
+  /* Missing fields read "Not stated by source" */
+  .not-stated {
+    font-style: italic;
+    text-decoration: underline dashed;
+    text-underline-offset: 4px;
+  }
 }
