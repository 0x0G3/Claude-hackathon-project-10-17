diff --git a/web/src/app/globals.css b/web/src/app/globals.css
index a2dc41e..ce250a6 100644
--- a/web/src/app/globals.css
+++ b/web/src/app/globals.css
@@ -1,26 +1,358 @@
 @import "tailwindcss";
 
+/*
+  Next Door · IHH design tokens
+  Source: design/design-system/tokens.json and design/HANDOFF.md.
+  Light only (the IHH system has no dark theme). Square corners, no shadows, no gradients.
+
+  Tailwind utilities you get from @theme below:
+    bg-yellow  bg-navy  bg-indigo  bg-sand  bg-white  text-charcoal ...
+    bg-accent  text-on-accent  bg-dark  text-on-dark  bg-soft  text-muted ...
+    font-display  font-sans
+  Prefer these over Tailwind's default palette (slate, blue, emerald ...).
+  Never: rounded-*, shadow-*, gradients, yellow text on white, white text on yellow.
+*/
+
 :root {
-  --background: #ffffff;
-  --foreground: #171717;
+  color-scheme: light;
+
+  /* Brand colors: one job each */
+  --ihh-yellow: #facc0a;   /* act: the one primary button, help strip, plan card head */
+  --ihh-navy: #122640;     /* all text, top bar, safety screens, selected states */
+  --ihh-indigo: #1a2187;   /* medicine route only */
+  --ihh-sand: #ede5de;     /* the person's own words, "what to say", resting blocks */
+  --ihh-white: #ffffff;    /* ground */
+  --ihh-charcoal: #33373d; /* secondary text, never for anything that matters */
+
+  /* Semantic roles */
+  --bg: var(--ihh-white);
+  --bg-soft: var(--ihh-sand);
+  --text: var(--ihh-navy);
+  --text-muted: var(--ihh-charcoal);
+  --accent: var(--ihh-yellow);
+  --on-accent: var(--ihh-navy);
+  --primary: var(--ihh-indigo);
+  --on-primary: var(--ihh-white);
+  --dark: var(--ihh-navy);
+  --on-dark: var(--ihh-white);
+  --highlight-on-dark: var(--ihh-yellow);
+  --focus-ring: var(--ihh-navy);
+  --focus-ring-on-dark: var(--ihh-yellow);
+
+  /* Layout */
+  --gutter: 20px;
+  --content-max: 1200px;
+  --text-max: 800px;
+
+  /* Lines: solid navy or white, never grey */
+  --border-thin: 1px;
+  --border-thick: 2px;
+
+  /* Tap targets (HANDOFF.md: phone 58, desktop 64, Make it easier 68) */
+  --tap-sm: 44px;
+  --tap: 58px;
+  --tap-lg: 64px;
+  --tap-xl: 68px;
+}
+
+@theme {
+  --color-yellow: #facc0a;
+  --color-navy: #122640;
+  --color-indigo: #1a2187;
+  --color-sand: #ede5de;
+  --color-charcoal: #33373d;
+  --color-white: #ffffff;
+
+  --color-accent: #facc0a;
+  --color-on-accent: #122640;
+  --color-primary: #1a2187;
+  --color-on-primary: #ffffff;
+  --color-dark: #122640;
+  --color-on-dark: #ffffff;
+  --color-soft: #ede5de;
+  --color-muted: #33373d;
